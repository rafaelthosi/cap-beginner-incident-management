{
  "name": "incident-management-teste-rmt",
  "version": "1.0.0",
  "description": "[Develop Extensions with CAP Following the SAP BTP Developer's Guide](https://learning.sap.com/courses/develop-extensions-with-cap-following-the-sap-btp-developer-s-guide/exercise-creating-a-cap-based-service_cc9e93f1-9dda-4f67-9d6b-c6bfefcc0b99)",
  "main": "index.js",
  "scripts": {
    "test": "jest tests/test.js",
    "start": "cds-serve",
    "dev": "cds-serve --profile development",
    "deleteDist": "rm -rf dist app/**/dist && rm -rf gen ./gen",
    "deleteMTAR": "rm mta_archives/*",
    "clean": "npm run deleteDist && npm run deleteMTAR",
    "newEnv": "cf env incident-management-teste-rmt-srv > default-env.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rafaelthosi/cap-beginner-incident-management.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/rafaelthosi/cap-beginner-incident-management/issues"
  },
  "homepage": "https://github.com/rafaelthosi/cap-beginner-incident-management#readme",
  "dependencies": {
    "@cap-js/hana": "^3",
    "@sap-cloud-sdk/connectivity": "^3.26.4",
    "@sap-cloud-sdk/http-client": "^3.26.4",
    "@sap-cloud-sdk/resilience": "^3.26.4",
    "@sap-cloud-sdk/util": "^3.26.4",
    "@sap/cds": "^10.1.0",
    "@sap/xssec": "^4"
  },
  "workspaces": [
    "app/*"
  ],
  "devDependencies": {
    "@cap-js/cds-test": "^1.0.2",
    "@cap-js/sqlite": "^3",
    "@sap/cds-dk": "^10",
    "jest": "^30.5.2"
  },
  "sapux": [
    "app/incidents"
  ],
  "cds": {
    "requires": {
      "API_BUSINESS_PARTNER": {
        "kind": "odata",
        "model": "srv/external/API_BUSINESS_PARTNER",
        "credentials": {
          "url": "https://sandbox.api.sap.com/s4hanacloud/sap/opu/odata/sap/API_BUSINESS_PARTNER/"
        }
      },
      "[development]": {
        "auth": {
          "kind": "mocked",
          "users": {
            "incident.support@tester.sap.com": {
              "password": "initial",
              "roles": [
                "support"
              ]
            },
            "alice": {
              "roles": [
                "support"
              ]
            },
            "bob": {
              "roles": [
                "support",
                "admin"
              ]
            }
          }
        }
      },
      "[production]": {
        "auth": "xsuaa",
        "db": "hana"
      },
      "html5-repo": true
    }
  }
}
